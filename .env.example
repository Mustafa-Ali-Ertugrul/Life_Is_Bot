# Telegram BotFather'dan aldığın token'ı buraya yaz (kimseyle paylaşma!)
BOT_TOKEN=

# Veritabanı bağlantısı (Faz 0: SQLite, Faz 1: PostgreSQL)
# Docker kullanıyorsanız compose volume path'ini otomatik override eder
DATABASE_URL=sqlite+aiosqlite:///life_is_bot.db

# Varsayılan zaman dilimi ve dil
TIMEZONE=Europe/Istanbul
LANGUAGE=tr

# Scheduler tick aralığı (saniye)
SCHEDULER_INTERVAL_SECONDS=60

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── API (WebApp / REST) ──
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=["*"]
API_KEY=
API_AUTH_MAX_AGE=86400

# ── Yedekleme ve raporlar ──
BACKUP_ENABLED=True
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
REPORTS_DIR=reports
AUTO_MONTHLY_REPORT=True

# ── Veri temizleme (ileride) ──
PURGE_ENABLED=False
DATA_RETENTION_MONTHS=1

# ── Webhook (production, public URL gerekir) ──
WEBHOOK_MODE=False
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Ortam ──
TZ=Europe/Istanbul
